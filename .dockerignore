.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.env
*.env
.idea/
.vscode/
.DS_Store
# Leading-slash-free patterns still only match at the root, so spell out the
# nested case: the indexing workflow clones and BUILDS these two repos inside
# the working directory, and `COPY . .` would otherwise bake the whole Lean
# toolchain into the web image. That is what happened on 2026-08-16 -- physlib/
# alone was 14 GB, the image reached 21 GB, and the dyno could not start inside
# the platform's boot window. Neither repo is needed at runtime.
physlib/
jixia/
**/.lake/
**/*.olean
**/*.ilean
.lake/
*.olean
*.ilean
*.log
frontend/node_modules/
frontend/.next/
frontend/out/
Dockerfile
.dockerignore
heroku.yml

# Nothing below is needed at runtime. Keeping it out matters: the web image is
# pulled on every dyno start, so extra weight directly slows boots.
.git/
.github/
.gitignore
db_export.zip
*.zip
*.dump
paper/
*.png
*.jpg
# NOTE: prompt/ and docs/ are NOT excluded — prompt/ holds Jinja templates the
# server loads at runtime (query_expansion.py reads prompt/augment_prompt.j2).
.pytest_cache/
.ruff_cache/
.mypy_cache/
